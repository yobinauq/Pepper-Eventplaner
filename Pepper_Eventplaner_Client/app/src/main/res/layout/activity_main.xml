<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#0F172A"
    tools:context=".MainActivity">

    <android.support.constraint.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Was Pepper gerade sagt -->
        <TextView
            android:id="@+id/txtBubble"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:padding="14dp"
            android:text="Pepper: (bereit)"
            android:textSize="18sp"
            android:textColor="#E2E8F0"
            android:background="@drawable/bubble_bg"
            android:typeface="monospace"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Was der Nutzer zuletzt gesagt hat -->
        <TextView
            android:id="@+id/txtUser"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text=""
            android:textSize="15sp"
            android:textColor="#94A3B8"
            android:typeface="monospace"
            app:layout_constraintTop_toBottomOf="@id/txtBubble"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- ACT-Up Gedaechtnis: erkannte Person + erinnerte Themen -->
        <TextView
            android:id="@+id/txtMemory"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:padding="14dp"
            android:text="Gedächtnis: noch niemand erkannt"
            android:textSize="15sp"
            android:textColor="#00FF41"
            android:background="@drawable/bubble_bg"
            android:typeface="monospace"
            app:layout_constraintTop_toBottomOf="@id/txtUser"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Umschalter: internes Pepper-Mikro <-> externes Handy-Mikro -->
        <Button
            android:id="@+id/btnMicMode"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:onClick="onToggleMicMode"
            android:text="Mikrofon: INTERN (Pepper)"
            android:textColor="#00FF41"
            android:typeface="monospace"
            android:textAllCaps="false"
            android:background="@drawable/btn_primary_selector"
            app:layout_constraintTop_toBottomOf="@id/txtMemory"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </android.support.constraint.ConstraintLayout>
</ScrollView>
